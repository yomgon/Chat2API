{
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.smoke-test-private-final/ts-reference-build/node",
    "tsBuildInfoFile": "./.smoke-test-private-final/ts-reference-build/node.tsbuildinfo",
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "vite.config.ts",
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/types/**/*.d.ts",
    "src/main/types/**/*.d.ts"
  ]
}
